  },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "koffi": "^2.9.0",
    "vigemclient": "^1.5.3"
  },
  "devDependencies": {}
}
