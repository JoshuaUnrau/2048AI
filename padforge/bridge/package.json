{
  "name": "padforge-bridge",
  "version": "0.1.0",
  "description": "PC bridge for PadForge: turns phones into custom game controllers (virtual Xbox 360 / DualShock 4, keyboard and mouse).",
  "main": "src/index.js",
  "bin": { "padforge": "src/index.js" },
  "scripts": {
    "start": "node src/index.js",
